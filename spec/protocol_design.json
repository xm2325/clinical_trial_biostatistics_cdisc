{
  "analysis_version": "0.7.0",
  "design_status": "Illustrative portfolio planning scenario; not the source study protocol or sponsor-approved design.",
  "objective": "Plan a three-arm parallel-group study with two active-versus-placebo comparisons for a continuous Week 24 ACTOT endpoint.",
  "endpoint": {
    "parameter": "ACTOT",
    "timepoint": "Week 24",
    "summary": "Change from baseline",
    "contrast": "Each active dose versus placebo"
  },
  "allocation": {
    "arms": [
      "Placebo",
      "Xanomeline Low Dose",
      "Xanomeline High Dose"
    ],
    "ratio": [1, 1, 1]
  },
  "multiplicity": {
    "method": "Bonferroni",
    "family_alpha": 0.05,
    "active_vs_control_comparisons": 2
  },
  "common_sd": 6.0,
  "dropout_rate": 0.15,
  "scenarios": [
    {"scenario_id": "E2.0_P80", "effect": 2.0, "power": 0.80},
    {"scenario_id": "E2.0_P90", "effect": 2.0, "power": 0.90},
    {"scenario_id": "E2.5_P80", "effect": 2.5, "power": 0.80},
    {"scenario_id": "E2.5_P90", "effect": 2.5, "power": 0.90},
    {"scenario_id": "E3.0_P80", "effect": 3.0, "power": 0.80},
    {"scenario_id": "E3.0_P90", "effect": 3.0, "power": 0.90}
  ]
}
